static bool checkDecoderPredicate(unsigned Idx, const FeatureBitset &FB) {
  switch (Idx) {
  default: llvm_unreachable("Invalid index!");
  case 0:
    return FB[AArch64::FeatureAll] || FB[AArch64::FeatureSME_MOP4];
  case 1:
    return (FB[AArch64::FeatureAll] || FB[AArch64::FeatureSME_MOP4]) && (FB[AArch64::FeatureAll] || FB[AArch64::FeatureSMEF8F32]);
  case 2:
    return (FB[AArch64::FeatureAll] || FB[AArch64::FeatureSME_MOP4]) && (FB[AArch64::FeatureAll] || FB[AArch64::FeatureSMEF8F16]);
  case 3:
    return FB[AArch64::FeatureAll] || FB[AArch64::FeatureSME_TMOP];
  case 4:
    return (FB[AArch64::FeatureAll] || FB[AArch64::FeatureSME_TMOP]) && (FB[AArch64::FeatureAll] || FB[AArch64::FeatureSMEF8F32]);
  case 5:
    return (FB[AArch64::FeatureAll] || FB[AArch64::FeatureSME_TMOP]) && (FB[AArch64::FeatureAll] || FB[AArch64::FeatureSMEF8F16]);
  case 6:
    return FB[AArch64::FeatureAll] || FB[AArch64::FeatureSME];
  case 7:
    return FB[AArch64::FeatureAll] || FB[AArch64::FeatureSME2];
  case 8:
    return FB[AArch64::FeatureAll] || FB[AArch64::FeatureSMEF8F32];
  case 9:
    return FB[AArch64::FeatureAll] || FB[AArch64::FeatureSMEF8F16];
  case 10:
    return FB[AArch64::FeatureAll] || FB[AArch64::FeatureSMEF64F64];
  case 11:
    return (FB[AArch64::FeatureAll] || FB[AArch64::FeatureSME_MOP4]) && (FB[AArch64::FeatureAll] || FB[AArch64::FeatureSMEF64F64]);
  case 12:
    return (FB[AArch64::FeatureAll] || FB[AArch64::FeatureSME_MOP4]) && (FB[AArch64::FeatureAll] || FB[AArch64::FeatureSMEF16F16]);
  case 13:
    return (FB[AArch64::FeatureAll] || FB[AArch64::FeatureSME_MOP4]) && (FB[AArch64::FeatureAll] || FB[AArch64::FeatureSMEB16B16]);
