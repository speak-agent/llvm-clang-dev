ArrayRef<MCPhysReg> AArch64GenRegisterInfo::getRawAllocationOrder(const TargetRegisterClass &RC, const MachineFunction &MF, bool Rev) const {
  switch (RC.getID()) {
  case AArch64::GPR32RegClassID:
    return GPR32GetRawAllocationOrder(RC, MF, Rev);
  case AArch64::GPR32spRegClassID:
    return GPR32spGetRawAllocationOrder(RC, MF, Rev);
  case AArch64::GPR32commonRegClassID:
    return GPR32commonGetRawAllocationOrder(RC, MF, Rev);
  case AArch64::GPR64RegClassID:
    return GPR64GetRawAllocationOrder(RC, MF, Rev);
  case AArch64::GPR64spRegClassID:
    return GPR64spGetRawAllocationOrder(RC, MF, Rev);
  case AArch64::GPR64commonRegClassID:
    return GPR64commonGetRawAllocationOrder(RC, MF, Rev);
  case AArch64::GPR64noipRegClassID:
    return GPR64noipGetRawAllocationOrder(RC, MF, Rev);
  case AArch64::GPR64common_and_GPR64noipRegClassID:
    return GPR64common_and_GPR64noipGetRawAllocationOrder(RC, MF, Rev);
  }
  return RC.getRegisters();
}


