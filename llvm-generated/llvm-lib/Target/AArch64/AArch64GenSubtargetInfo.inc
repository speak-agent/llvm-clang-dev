                        nullptr, nullptr, nullptr) {}

unsigned AArch64GenSubtargetInfo
::resolveSchedClass(unsigned SchedClass, const MachineInstr *MI, const TargetSchedModel *SchedModel) const {

  const AArch64InstrInfo *TII =
    static_cast<const AArch64InstrInfo*>(SchedModel->getInstrInfo());
  (void)TII;

  switch (SchedClass) {
  case 9: // WriteF
    if (SchedModel->getProcessorID() == 8) { // C1UltraModel
      if (this->hasFeature(AArch64::FeatureSME) && this->hasFeature(AArch64::FeatureMCAStreamingSched))
        return 2196; // C1UWrite_4c_1CMEVXALU
      if (this->hasFeature(AArch64::FeatureSME))
        return 2197; // C1UWrite_2c_1V
    }
    break;
  case 18: // WriteISReg_ReadI_ReadISReg
    if (SchedModel->getProcessorID() == 4) { // NeoverseN3Model
      if ((
            AArch64_AM::getShiftType(MI->getOperand(3).getImm()) == AArch64_AM::LSL
            && (
              AArch64_AM::getShiftValue(MI->getOperand(3).getImm()) == 0
              || AArch64_AM::getShiftValue(MI->getOperand(3).getImm()) == 1
              || AArch64_AM::getShiftValue(MI->getOperand(3).getImm()) == 2
              || AArch64_AM::getShiftValue(MI->getOperand(3).getImm()) == 3
              || AArch64_AM::getShiftValue(MI->getOperand(3).getImm()) == 4
            )
          ))
        return 2198; // N3Write_1c_1I_ReadI_ReadISReg
      return 2199; // N3Write_2c_1M_ReadI_ReadISReg
    }
    if (SchedModel->getProcessorID() == 7) { // C1PremiumModel
      if ((
            AArch64_AM::getShiftType(MI->getOperand(3).getImm()) == AArch64_AM::LSL
            && (
              AArch64_AM::getShiftValue(MI->getOperand(3).getImm()) == 0
              || AArch64_AM::getShiftValue(MI->getOperand(3).getImm()) == 1
              || AArch64_AM::getShiftValue(MI->getOperand(3).getImm()) == 2
              || AArch64_AM::getShiftValue(MI->getOperand(3).getImm()) == 3
              || AArch64_AM::getShiftValue(MI->getOperand(3).getImm()) == 4
            )
          ))
        return 2200; // C1PWrite_1c_1I_ReadI_ReadISReg
      return 2201; // C1PWrite_2c_1I_ReadI_ReadISReg
    }
    if (SchedModel->getProcessorID() == 8) { // C1UltraModel
      if ((
            AArch64_AM::getShiftType(MI->getOperand(3).getImm()) == AArch64_AM::LSL
            && (
              AArch64_AM::getShiftValue(MI->getOperand(3).getImm()) == 0
              || AArch64_AM::getShiftValue(MI->getOperand(3).getImm()) == 1
              || AArch64_AM::getShiftValue(MI->getOperand(3).getImm()) == 2
              || AArch64_AM::getShiftValue(MI->getOperand(3).getImm()) == 3
              || AArch64_AM::getShiftValue(MI->getOperand(3).getImm()) == 4
            )
          ))
        return 2202; // C1UWrite_1c_1I_ReadI_ReadISReg
      return 2203; // C1UWrite_2c_1I_ReadI_ReadISReg
    }
    if (SchedModel->getProcessorID() == 10) { // CortexA53Model
      if (AArch64InstrInfo::hasShiftedReg(*MI))
        return 2204; // WriteISReg_ReadI_A53ReadShifted
      return 2205; // WriteISReg_ReadI_A53ReadNotShifted
    }
    if (SchedModel->getProcessorID() == 12) { // CortexA55Model
      if (AArch64InstrInfo::hasShiftedReg(*MI))
        return 2206; // WriteISReg_ReadI_CortexA55ReadShifted
      return 2207; // WriteISReg_ReadI_CortexA55ReadNotShifted
    }
    if (SchedModel->getProcessorID() == 14) { // NeoverseN2Model
      if ((
            AArch64_AM::getShiftType(MI->getOperand(3).getImm()) == AArch64_AM::LSL
            && (
              AArch64_AM::getShiftValue(MI->getOperand(3).getImm()) == 0
              || AArch64_AM::getShiftValue(MI->getOperand(3).getImm()) == 1
              || AArch64_AM::getShiftValue(MI->getOperand(3).getImm()) == 2
              || AArch64_AM::getShiftValue(MI->getOperand(3).getImm()) == 3
              || AArch64_AM::getShiftValue(MI->getOperand(3).getImm()) == 4
            )
          ))
        return 2208; // N2Write_1c_1I_ReadI_ReadISReg
      return 2209; // N2Write_2c_1M_ReadI_ReadISReg
    }
    if (SchedModel->getProcessorID() == 15) { // NeoverseN1Model
      if ((
            AArch64_AM::getShiftType(MI->getOperand(3).getImm()) == AArch64_AM::LSL
            && (
              AArch64_AM::getShiftValue(MI->getOperand(3).getImm()) == 0
              || AArch64_AM::getShiftValue(MI->getOperand(3).getImm()) == 1
              || AArch64_AM::getShiftValue(MI->getOperand(3).getImm()) == 2
              || AArch64_AM::getShiftValue(MI->getOperand(3).getImm()) == 3
              || AArch64_AM::getShiftValue(MI->getOperand(3).getImm()) == 4
            )
          ))
        return 2210; // N1Write_1c_1I_ReadI_ReadISReg
      return 2211; // N1Write_2c_1M_ReadI_ReadISReg
    }
    if (SchedModel->getProcessorID() == 16) { // NeoverseV1Model
      if ((
            AArch64_AM::getShiftType(MI->getOperand(3).getImm()) == AArch64_AM::LSL
            && (
              AArch64_AM::getShiftValue(MI->getOperand(3).getImm()) == 0
              || AArch64_AM::getShiftValue(MI->getOperand(3).getImm()) == 1
              || AArch64_AM::getShiftValue(MI->getOperand(3).getImm()) == 2
              || AArch64_AM::getShiftValue(MI->getOperand(3).getImm()) == 3
              || AArch64_AM::getShiftValue(MI->getOperand(3).getImm()) == 4
            )
          ))
        return 2212; // V1Write_1c_1I_ReadI_ReadISReg
      return 2213; // V1Write_2c_1M_ReadI_ReadISReg
    }
    if (SchedModel->getProcessorID() == 17) { // NeoverseV2Model
      if ((
