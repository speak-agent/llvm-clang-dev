    /* 17782 */ "uqdech	$\x01, $\xFF\x03\x0E\0"
    /* 17798 */ "uqdech	$\xFF\x01\x09\0"
    /* 17810 */ "uqdech	$\xFF\x01\x09, $\xFF\x03\x0E\0"
    /* 17828 */ "uqdecw	$\x01\0"
    /* 17838 */ "uqdecw	$\x01, $\xFF\x03\x0E\0"
    /* 17854 */ "uqdecw	$\xFF\x01\x0B\0"
    /* 17866 */ "uqdecw	$\xFF\x01\x0B, $\xFF\x03\x0E\0"
    /* 17884 */ "uqincb	$\x01\0"
    /* 17894 */ "uqincb	$\x01, $\xFF\x03\x0E\0"
    /* 17910 */ "uqincd	$\x01\0"
    /* 17920 */ "uqincd	$\x01, $\xFF\x03\x0E\0"
    /* 17936 */ "uqincd	$\xFF\x01\x10\0"
    /* 17948 */ "uqincd	$\xFF\x01\x10, $\xFF\x03\x0E\0"
